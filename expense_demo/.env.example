# ===== 运行环境 =====
# 默认生产模式 prod：无 Key 也能启动——统计始终可用，记账/查账按 Key 开关降级关闭。
# 想在本地看演示数据/完整功能，可改成 APP_ENV=dev。
APP_ENV=prod
# 是否灌入演示数据：留空=跟随 APP_ENV（dev 开、prod 关）；也可显式 true / false
ENABLE_SEED=
# 严格模式：true 时启动强制要求 ZAI_API_KEY（缺 Key 直接失败），用于部署自检
STRICT=false

# ===== 智谱 GLM API（OpenAI 兼容端点）=====
ZAI_API_KEY=
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# ===== 模型名（按账号实际开通的服务调整）=====
# ZAI_BASE_URL 只写到 /v1 或 /api/paas/v4/，不要带 /chat/completions（SDK 会自己拼）。
# glm-5.2 / glm-5.3 是纯文本模型：文字记账/查账可用；图片 OCR、语音 ASR 不支持。
# 纯文本模型只能配 MODEL_TEXT；MODEL_VISION 需多模态模型（如 glm-5.3-flash / glm-4v-plus）。
MODEL_TEXT=glm-5.3
MODEL_VISION=glm-5.3-flash
# ASR 需平台提供 OpenAI 兼容的 /audio/transcriptions 端点；没有则语音记账不可用，用文字记账替代。
MODEL_AUDIO=glm-asr-2512
# GLM-5.x 强制思考，low 档最快最省；留空则不传（兼容不认识该参数的端点）。可选 low/high/max
REASONING_EFFORT=low

# SQLite 路径：本地 ./data/expense.db；容器内 /app/data/expense.db
DB_PATH=./data/expense.db
